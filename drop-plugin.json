{
  "id": "drop-emulation",
  "name": "Emulation & ROM Linking",
  "version": "0.1.0",
  "description": "Links ROM titles to emulators and rewrites launch arguments",
  "author": "Heretek Games",
  "apiVersion": 2,
  "trust": "trusted",
  "storageVersion": 1,
  "capabilities": [
    "ui:slot",
    "game:launch-hook",
    "system:command",
    "game:fs",
    "client:storage"
  ],
  "targets": [
    "client"
  ],
  "entry": "dist/src/index.js",
  "client": {
    "entry": "dist/src/index.js",
    "capabilities": [
      "ui:slot",
      "game:launch-hook",
      "system:command",
      "game:fs",
      "client:storage"
    ],
    "commands": [
      "retroarch",
      "dolphin-emu",
      "duckstation-qt",
      "pcsx2-qt",
      "melonds",
      "mgba-qt",
      "snes9x-gtk",
      "mupen64plus",
      "flycast",
      "ppsspp-qt"
    ]
  }
}